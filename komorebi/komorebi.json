{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.40/schema.json",
  "default_layout": "bsp",
  "window_rule_exceptions": [],
  "enable_pause_command": true,
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 4,
  "default_container_padding": 4,
  "border": true,
  "border-implementation": "Native",
  "boarder_style": "System",
  "border_width": 3,
  "border_offset": 0,
  "border_colours": {
    "single": "#89A3EA",
    "stack": "#89A3EA",
    "floating": "#89A3EA",
    "monocle": "#89A3EA",
    "unfocused": "#0E2357"
  },
  "mouse_follows_focus": true,
  "transparency": true,
  "transparency_alpha": 220,
  "animation": {
    "enabled":true,
    "duration":200,
    "fps": 60,
    "style":{
      "movement":"EaseOutBack",
      "transparency":"Linear"
    } 
  },
  "stackbar": {
    "height": 24,
    "mode": "Never",
    "label": "Title",
    "tabs": {
      "width": 200,
      "font_size": 16
    }
  }
}
